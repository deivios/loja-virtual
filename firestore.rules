rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        (
          request.auth.token.admin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true
        );
    }

    // Home: seções da tela inicial - qualquer pessoa pode LER
    match /home/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Produtos: qualquer pessoa pode LER (para exibir no app sem login)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Usuários: cada usuário lê/escreve apenas o próprio documento
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Carrinho: subcoleção users/{userId}/cart - cada usuário acessa apenas seu carrinho
      match /cart/{cartItemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

